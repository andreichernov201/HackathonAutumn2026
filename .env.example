REGULA_SESSION_SECRET=replace-with-long-random-secret
# Optional local knowledge maintenance password (at least 32 characters).
# Empty value disables knowledge administration. Never use a VITE_ variable.
REGULA_KNOWLEDGE_ADMIN_TOKEN=
# Set to 0 for an empty knowledge corpus. By default import 3 synthetic originals.
REGULA_IMPORT_CASE_CORPUS=1
