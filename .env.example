# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
REGULA_SESSION_SECRET=
# Compose binds only to localhost. For external HTTPS use production and secure cookies.
REGULA_ENV=development
REGULA_SECURE_COOKIE=0
# Optional local knowledge maintenance password (at least 32 characters).
# Empty value disables knowledge administration. Never use a VITE_ variable.
REGULA_KNOWLEDGE_ADMIN_TOKEN=
# Set to 0 for an empty knowledge corpus. By default import 3 synthetic originals.
REGULA_IMPORT_CASE_CORPUS=1

# Server-only inference settings. Leave key empty for local search/forms without AI.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_THINKING=1
AI_MAX_TOOL_STEPS=16
AI_REQUEST_TIMEOUT=90
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_MODEL_CALLS=12
AI_MAX_TOTAL_TOKENS=80000
AI_MAX_CONTEXT_CHARS=100000
AI_REQUESTS_PER_HOUR=30
# Future private OpenAI-compatible endpoint; qualify tool-calling before use.
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=
QWEN_API_KEY=
