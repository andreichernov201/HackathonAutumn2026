# Root-only /etc/regula/regula.env. Do not commit populated copies.
DOMAIN=
ACME_EMAIL=
REGULA_ACCESS_USER=
REGULA_ACCESS_HASH=
# Set 1 only for a deliberately public demo with synthetic documents.
REGULA_PUBLIC_DEMO=0
REGULA_SESSION_SECRET=
REGULA_KNOWLEDGE_ADMIN_TOKEN=
REGULA_ENV=production
REGULA_SECURE_COOKIE=1
REGULA_IMPORT_CASE_CORPUS=1
REGULA_PROJECT=regula
REGULA_DATA_VOLUME=regula_data
REGULA_CADDY_DATA_VOLUME=regula_caddy_data
REGULA_CADDY_CONFIG_VOLUME=regula_caddy_config

# Server-only inference settings. Leave key empty for local search/forms without AI.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_THINKING=1
AI_MAX_TOOL_STEPS=16
AI_REQUEST_TIMEOUT=90
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_MODEL_CALLS=12
AI_MAX_TOTAL_TOKENS=80000
AI_MAX_CONTEXT_CHARS=100000
AI_REQUESTS_PER_HOUR=30
# Future private OpenAI-compatible endpoint; qualify tool-calling before use.
QWEN_BASE_URL=http://127.0.0.1:8001/v1
QWEN_MODEL=
QWEN_API_KEY=
